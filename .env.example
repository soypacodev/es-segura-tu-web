# Enlace para compartir informes (opcional). Sin estas variables, el botón no aparece.
# Copia este archivo a .env.local y rellénalo; no lo subas a git.

# Proyecto de Supabase donde se ejecutó supabase/informes.sql
SUPABASE_URL=
# Clave «service_role» (Settings > API). Solo servidor: nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Cadena aleatoria de 32 caracteres o más, por ejemplo:  openssl rand -hex 32
INFORME_SECRETO=
# Días que se conserva un informe compartido (1-365). Por defecto, 30.
INFORME_DIAS=30
